<figure class="diagram" data-compare>
  <div class="diagram-bar">
    <div class="diagram-tabs" role="tablist" aria-label="Credit flow view">
      <button type="button" role="tab" data-view="compare" class="is-active" aria-selected="true">Compare</button>
      <button type="button" role="tab" data-view="before" aria-selected="false">Collections</button>
      <button type="button" role="tab" data-view="after" aria-selected="false">The design</button>
    </div>
    <button type="button" class="diagram-play">Play flow</button>
  </div>
  <svg viewBox="0 0 758 258" role="img" aria-label="Two money paths compared. In the collections model, credit is disbursed, the farmer harvests and sells elsewhere, and repayment is chased afterwards. In the netting model, the sale is routed through the platform, outstanding credit is netted, and the farmer receives the remainder.">
    <defs>
      <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="currentColor"></path>
      </marker>
      <marker id="aha" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--lapis)"></path>
      </marker>
    </defs>
    <g class="d-row d-row-before">
      <text x="0" y="12" class="dlabel" fill="currentColor" opacity=".65">Collections model</text>
      <g class="d-step" style="--i:0">
        <rect x="0" y="24" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="56" y="50" font-size="12" text-anchor="middle" fill="currentColor">Disburse</text>
      </g>
      <g class="d-step" style="--i:1">
        <rect x="146" y="24" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="202" y="50" font-size="12" text-anchor="middle" fill="currentColor">Harvest</text>
      </g>
      <g class="d-step" style="--i:2">
        <rect x="292" y="24" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="348" y="44" font-size="12" text-anchor="middle" fill="currentColor">Sold</text>
        <text x="348" y="58" font-size="12" text-anchor="middle" fill="currentColor">elsewhere</text>
      </g>
      <g class="d-step" style="--i:3">
        <rect x="438" y="24" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity=".55"></rect>
        <text x="494" y="50" font-size="12" text-anchor="middle" fill="currentColor" opacity=".7">Repaid?</text>
      </g>
      <line class="d-flow" x1="112" y1="45" x2="142" y2="45" stroke="currentColor" stroke-width="1.4" marker-end="url(#ah)"></line>
      <line class="d-flow" x1="258" y1="45" x2="288" y2="45" stroke="currentColor" stroke-width="1.4" marker-end="url(#ah)"></line>
      <line class="d-flow d-flow-weak" x1="404" y1="45" x2="434" y2="45" stroke="currentColor" stroke-width="1.4" stroke-dasharray="4 3" opacity=".55" marker-end="url(#ah)"></line>
      <path class="d-flow d-flow-weak" d="M 494 66 L 494 96 L 56 96 L 56 70" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="4 3" opacity=".55" marker-end="url(#ah)"></path>
      <text x="275" y="112" font-size="11.5" text-anchor="middle" fill="currentColor" opacity=".65">chase repayment · months later · income already spent</text>
    </g>
    <line x1="0" y1="140" x2="758" y2="140" stroke="currentColor" stroke-width="1" opacity=".18"></line>
    <g class="d-row d-row-after">
      <text x="0" y="166" class="dlabel" fill="var(--lapis)">The design</text>
      <g class="d-step" style="--i:4">
        <rect x="0" y="178" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="56" y="204" font-size="12" text-anchor="middle" fill="currentColor">Disburse</text>
      </g>
      <g class="d-step" style="--i:5">
        <rect x="146" y="178" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="202" y="204" font-size="12" text-anchor="middle" fill="currentColor">Harvest</text>
      </g>
      <g class="d-step" style="--i:6">
        <rect x="292" y="178" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="348" y="198" font-size="12" text-anchor="middle" fill="currentColor">Sale via</text>
        <text x="348" y="212" font-size="12" text-anchor="middle" fill="currentColor">platform</text>
      </g>
      <g class="d-step d-key" style="--i:7">
        <rect x="438" y="178" width="112" height="42" rx="6" fill="var(--lapis)" stroke="var(--lapis)" stroke-width="1"></rect>
        <text x="494" y="198" font-size="12" text-anchor="middle" fill="var(--paper)" font-weight="500">Net</text>
        <text x="494" y="212" font-size="12" text-anchor="middle" fill="var(--paper)" font-weight="500">outstanding</text>
      </g>
      <g class="d-step" style="--i:8">
        <rect x="584" y="178" width="112" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
        <text x="640" y="204" font-size="12" text-anchor="middle" fill="currentColor">Payout</text>
      </g>
      <line class="d-flow" x1="112" y1="199" x2="142" y2="199" stroke="currentColor" stroke-width="1.4" marker-end="url(#ah)"></line>
      <line class="d-flow" x1="258" y1="199" x2="288" y2="199" stroke="currentColor" stroke-width="1.4" marker-end="url(#ah)"></line>
      <line class="d-flow d-flow-key" x1="404" y1="199" x2="434" y2="199" stroke="var(--lapis)" stroke-width="2" marker-end="url(#aha)"></line>
      <line class="d-flow d-flow-key" x1="550" y1="199" x2="580" y2="199" stroke="var(--lapis)" stroke-width="2" marker-end="url(#aha)"></line>
      <text x="494" y="240" font-size="11.5" text-anchor="middle" fill="var(--lapis)">repayment happens here, not later</text>
    </g>
  </svg>
  <figcaption>
    The same four steps in both models. The difference is one node: netting sits inside the settlement path, so the money never leaves the platform uncollected. The dashed return arrow is the step that disappears.
  </figcaption>
</figure>
