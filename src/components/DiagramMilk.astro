<figure class="diagram">
  <svg viewBox="0 0 758 232" role="img" aria-label="Two capture flows compared. In the conventional flow the operator opens the app and selects an entry type before recording a reading. In the flow we shipped, scanning a coded bottle or butyrometer determines the screen, removing the selection step.">
    <defs>
      <marker id="mh" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="currentColor"></path>
      </marker>
      <marker id="mha" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--lapis)"></path>
      </marker>
    </defs>

    <text x="0" y="12" class="dlabel" fill="currentColor" opacity=".65">Conventional capture</text>
    <g class="d-step" style="--i:0">
      <rect x="0" y="24" width="140" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
      <text x="70" y="50" font-size="12" text-anchor="middle" fill="currentColor">Open the app</text>
    </g>
    <g class="d-step" style="--i:1">
      <rect x="174" y="24" width="196" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
      <text x="272" y="44" font-size="12" text-anchor="middle" fill="currentColor">Operator picks the</text>
      <text x="272" y="58" font-size="12" text-anchor="middle" fill="currentColor">entry type</text>
    </g>
    <g class="d-step" style="--i:2">
      <rect x="404" y="24" width="170" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity=".6"></rect>
      <text x="489" y="50" font-size="12" text-anchor="middle" fill="currentColor" opacity=".75">Record the reading</text>
    </g>
    <line class="d-flow" x1="140" y1="45" x2="170" y2="45" stroke="currentColor" stroke-width="1.4" marker-end="url(#mh)"></line>
    <line class="d-flow" x1="370" y1="45" x2="400" y2="45" stroke="currentColor" stroke-width="1.4" marker-end="url(#mh)"></line>
    <path class="d-flow d-flow-weak" d="M 272 66 L 272 88 L 70 88 L 70 70" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".5"></path>
    <text x="292" y="92" font-size="11.5" fill="currentColor" opacity=".7">a selection step at every reading — slow enough that the paper diary stayed in use</text>

    <line x1="0" y1="118" x2="758" y2="118" stroke="currentColor" stroke-width="1" opacity=".18"></line>

    <text x="0" y="144" class="dlabel" fill="var(--lapis)">What we shipped</text>
    <g class="d-step d-key" style="--i:3">
      <rect x="0" y="156" width="250" height="42" rx="6" fill="var(--lapis)" stroke="var(--lapis)" stroke-width="1"></rect>
      <text x="125" y="176" font-size="12" text-anchor="middle" fill="var(--paper)" font-weight="500">Scan the coded bottle</text>
      <text x="125" y="190" font-size="11" text-anchor="middle" fill="var(--paper)" opacity=".85">or butyrometer</text>
    </g>
    <g class="d-step" style="--i:4">
      <rect x="284" y="156" width="176" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
      <text x="372" y="176" font-size="12" text-anchor="middle" fill="currentColor">The screen is</text>
      <text x="372" y="190" font-size="12" text-anchor="middle" fill="currentColor">already decided</text>
    </g>
    <g class="d-step" style="--i:5">
      <rect x="494" y="156" width="170" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="1"></rect>
      <text x="579" y="181" font-size="12" text-anchor="middle" fill="currentColor">Record the reading</text>
    </g>
    <line class="d-flow d-flow-key" x1="250" y1="177" x2="280" y2="177" stroke="var(--lapis)" stroke-width="2" marker-end="url(#mha)"></line>
    <line class="d-flow" x1="460" y1="177" x2="490" y2="177" stroke="currentColor" stroke-width="1.4" marker-end="url(#mh)"></line>
    <text x="0" y="222" font-size="11.5" fill="var(--lapis)">no selection step. checks fire at random, and every fat reading is bound to the tester who ran it</text>
  </svg>
  <figcaption>
    Both flows record the same reading. The selection step is the one the operator can get wrong, skip, or find slow enough to abandon — so the scanned object makes the choice instead of the person holding the phone.
  </figcaption>
</figure>
