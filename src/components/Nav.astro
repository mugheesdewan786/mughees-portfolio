---
const links = [
  { href: "#work", label: "Work" },
  { href: "#cases", label: "Cases" },
  { href: "#said", label: "People" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav" id="site-nav">
  <div class="nav-inner">
    <a class="brand" href="#home">
      <span class="brand-en">Mughees Dewan</span>
      <span class="brand-ar">مغیث دیوان</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" id="nav-toggle" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links" id="nav-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
      <li>
        <a class="nav-cta" href="https://wa.me/923016863330">WhatsApp</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");
  if (nav && toggle && links) {
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Menu");
    });
    links.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.tagName === "A") {
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Menu");
      }
    });
  }
</script>
